ined":"Sun Feb 03 04:09:45 +0000 2008","protected":false,"website":{"url":"https://paulbakaus.com","display_url":"paulbakaus.com"},"verification":{"verified":true,"verified_at":null,"type":"individual"},"type":"profile"},"replies":0,"reposts":0,"likes":1,"bookmarks":0,"quotes":0,"embed_card":"tweet","created_at":"Thu Sep 24 00:38:20 +0000 2026","created_timestamp":1790210300,"views":121,"is_note_tweet":false,"community_note":null,"lang":"en","replying_to":{"screen_name":"illscience","status":"2102913284190220421","url":"https://x.com/illscience/status/2102913284190220421","profile_url":"https://x.com/illscience"},"media":{},"source":"Twitter Web App","provider":"twitter","reposted_by":null},{"type":"status","url":"https://x.com/illscience/status/2102913286396367175","id":"2102913286396367175","text":"Prompt: I want you to create a Habbo Hotel isometric game where you wander around a record shop inspired by Play De Record in Toronto or Gramophone. You can look through stacks of records, which are real songs. You can preview them, and when you're not, there's a turntable at the back where people are playing tracks that everyone who's in the room can listen to. I want to match the visual style of Habbo Hotel with the layout of these record stores in the 1990s, and obviously have everybody look like they're kind of DJ-inspired and from the 1990s potentially. We've done a bunch of work on Blender and things like that in the past, so feel free to look past our old threads to look at how we did the Contra game and see if that helps you at all, and feel free to use anything you need that's remote, like GPU rendering to make this faster.","raw_text":{"text":"Prompt: I want you to create a Habbo Hotel isometric game where you wander around a record shop inspired by Play De Record in Toronto or Gramophone. You can look through stacks of records, which are real songs. You can preview them, and when you're not, there's a turntable at the back where people are playing tracks that everyone who's in the room can listen to. I want to match the visual style of Habbo Hotel with the layout of these record stores in the 1990s, and obviously have everybody look like they're kind of DJ-inspired and from the 1990s potentially. We've done a bunch of work on Blender and things like that in the past, so feel free to look past our old threads to look at how we did the Contra game and see if that helps you at all, and feel free to use anything you need that's remote, like GPU rendering to make this faster.","display_text_range":[0,844],"facets":[{"type":"media","indices":[281,304],"id":"2102912573347921920","display":"pic.x.com/zX2G68Gb90","original":"https://t.co/zX2G68Gb90","replacement":"https://x.com/illscience/status/2102913286396367175/photo/1"}]},"author":{"screen_name":"illscience","url":"https://x.com/illscience","id":"24181760","followers":35125,"following":2928,"likes":37456,"media_count":443,"statuses":4012,"name":"Anish Acharya","description":"🦞AI Apps investing @ A16Z; A1111; Boards of Ethos, Krea, Deel, Clutch, Untitled, Happy Robot + more; If you’re not at the table, you’re on the menu","raw_description":{"text":"🦞AI Apps investing @ A16Z; A1111; Boards of Ethos, Krea, Deel, Clutch, Untitled, Happy Robot + more; If you’re not at the table, you’re on the menu","facets":[]},"location":"San Francisco","banner_url":"https://pbs.twimg.com/profile_banners/24181760/1786285530","avatar_url":"https://pbs.twimg.com/profile_images/1754574715363241986/3QOB64HZ_200x200.jpg","joined":"Fri Mar 13 14:45:20 +0000 2009","protected":false,"website":{"url":"https://open.substack.com/pub/illscience","display_url":"open.substack.com/pub/illscience"},"verification":{"verified":true,"verified_at":null,"type":"individual"},"type":"profile"},"replies":0,"reposts":1,"likes":1,"bookmarks":3,"quotes":0,"embed_card":"summary_large_image","created_at":"Thu Sep 24 00:09:32 +0000 2026","created_timestamp":1790208572,"possibly_sensitive":false,"views":718,"is_note_tweet":t