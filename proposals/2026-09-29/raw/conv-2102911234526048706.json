/video.twimg.com/amplify_video/2102909490500886528/vid/avc1/640x360/KNpney2S5jumfD6S.mp4?tag=29","bitrate":832000,"container":"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2102909490500886528/vid/avc1/1280x720/TtCtfUrFVrE3BNMa.mp4?tag=29","bitrate":2176000,"container":"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2102909490500886528/vid/avc1/1920x1080/p7YQUKcxUxi9n9LX.mp4?tag=29","bitrate":10368000,"container":"mp4","codec":"h264"}],"publisher":null}]},"provider":"twitter","reposted_by":null}],"replies":[{"type":"status","url":"https://x.com/throughiris_/status/2102911236237414411","id":"2102911236237414411","text":"I think one big issue is these model's don't have native video understanding, so they miss some of the nuanced motion in their work and when you show them references.\n\nI've come up a few work arounds and skill files, I'm going to keep working on these and making more vidoes to see where their strengths and weaknesses.  \n\nNext, I want to try using the Video gen models for footage like the ink spills and mountain fly-throughs, then After Effects for editable type and graphics. Seems like a pretty limitless combo\n\nI'm going to making marketing, branding and promos for Shared Canvas to experiment with the best AI tools,  I’ll share the process as I go.\n\nhttps://sharedcanvas.ai","raw_text":{"text":"I think one big issue is these model's don't have native video understanding, so they miss some of the nuanced motion in their work and when you show them references.\n\nI've come up a few work arounds and skill files, I'm going to keep working on these and making more vidoes to see where their strengths and weaknesses.  \n\nNext, I want to try using the Video gen models for footage like the ink spills and mountain fly-throughs, then After Effects for editable type and graphics. Seems like a pretty limitless combo\n\nI'm going to making marketing, branding and promos for Shared Canvas to experiment with the best AI tools,  I’ll share the process as I go.\n\nhttps://t.co/lEluuwLgW3","display_text_range":[0,681],"facets":[{"type":"url","indices":[658,681],"original":"https://t.co/lEluuwLgW3","replacement":"https://sharedcanvas.ai","display":"sharedcanvas.ai"}]},"author":{"screen_name":"throughiris_","url":"https://x.com/throughiris_","id":"22347107","followers":87,"following":532,"likes":535,"media_count":19,"statuses":90,"name":"Kris","description":"Creative director / motion designer. 20 years in design & animation, the last 10 as in-house creative lead @ Apple","raw_description":{"text":"Creative director / motion designer. 20 years in design & animation, the last 10 as in-house creative lead @ Apple","facets":[]},"location":"Los Angeles","banner_url":"https://pbs.twimg.com/profile_banners/22347107/1684537560","avatar_url":"https://pbs.twimg.com/profile_images/1966599218166161408/_eYomKMg_200x200.jpg","joined":"Sun Mar 01 10:05:13 +0000 2009","protected":false,"website":null,"verification":{"verified":true,"verified_at":null,"type":"individual"},"type":"profile"},"replies":0,"reposts":0,"likes":0,"bookmarks":0,"quotes":0,"embed_card":"tweet","created_at":"Thu Sep 24 00:01:23 +0000 2026","created_timestamp":1790208083,"views":21,"is_note_tweet":true,"community_note":null,"lang":"en","replying_to":{"screen_name":"throughiris_","status":"2102911234526048706","url":"https://x.com/throughiris_/status/2102911234526048706","profile_url":"https://x.com/throughiris_"},"media":{},"card":{"url":"https://sharedcanvas.ai","title":"Shared Canvas","description":"Shared Canvas is an editable document workspace for working with AI, choosing among major-provider, open-source, and open-weight models, and shaping the result yourself.","domain":"sharedcanvas.ai","image":{"width":800,"height":419,"url":"https://pbs.twimg.com/card_img/2102911231623630848/nmhlqhRV?format=jpg&name=800x419"}},"provider":"twitter","reposted_by":null}],"author":{"screen_name":"throughiris_","url":"https://x.com/throug