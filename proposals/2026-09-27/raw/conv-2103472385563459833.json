profile_banners/1437655880/1774158076","avatar_url":"https://pbs.twimg.com/profile_images/2071220022966648832/rNPOofEG_200x200.jpg","joined":"Sat May 18 07:20:08 +0000 2013","protected":false,"website":null,"verification":{"verified":true,"verified_at":null,"type":"individual"},"type":"profile"},"replies":0,"reposts":0,"likes":0,"bookmarks":0,"quotes":0,"embed_card":"summary_large_image","created_at":"Fri Sep 25 14:30:34 +0000 2026","created_timestamp":1790346634,"possibly_sensitive":false,"views":1029,"is_note_tweet":false,"community_note":null,"lang":"en","replying_to":{"screen_name":"shneural","status":"2103472385563459833","url":"https://x.com/shneural/status/2103472385563459833","profile_url":"https://x.com/shneural"},"media":{},"quote":{"type":"status","url":"https://x.com/AGTPinsights/status/2102651799987732852","id":"2102651799987732852","text":"Anthropic's Claude Opus 5.5 just wowed developers with viral Dark Souls-style game demos today. Here's what you need to know.\n\nAnthropic launched Claude Opus 5.5 on September 22, 2026, its new flagship model for reasoning, coding, and long-horizon agentic work, succeeding Opus 5. It's available on all platforms and priced at $4 per million input tokens and $20 per million output tokens, down 20% from Opus 5.\n\nForward Future's Alex got early access and posted demos he built with it, including a Dark Souls-style action game with real combat and level design, plus a doodle shooter. Commenters, including Matthew Berman, called it one of the most convincing FromSoftware-style recreations they'd seen from AI, with several stunned it took only a couple of prompts.\n\nKey numbers:\n- Release date: September 22, 2026\n- Input pricing: $4 per million tokens\n- Output pricing: $20 per million tokens\n- Price cut: 20% versus Opus 5\n- Fast mode: up to 2.5x speed at 2x standard pricing\n\nAlex's original demo thread has drawn over 400K views since posting.","raw_text":{"text":"Anthropic's Claude Opus 5.5 just wowed developers with viral Dark Souls-style game demos today. Here's what you need to know.\n\nAnthropic launched Claude Opus 5.5 on September 22, 2026, its new flagship model for reasoning, coding, and long-horizon agentic work, succeeding Opus 5. It's available on all platforms and priced at $4 per million input tokens and $20 per million output tokens, down 20% from Opus 5.\n\nForward Future's Alex got early access and posted demos he built with it, including a Dark Souls-style action game with real combat and level design, plus a doodle shooter. Commenters, including Matthew Berman, called it one of the most convincing FromSoftware-style recreations they'd seen from AI, with several stunned it took only a couple of prompts.\n\nKey numbers:\n- Release date: September 22, 2026\n- Input pricing: $4 per million tokens\n- Output pricing: $20 per million tokens\n- Price cut: 20% versus Opus 5\n- Fast mode: up to 2.5x speed at 2x standard pricing\n\nAlex's original demo thread has drawn over 400K views since posting.","display_text_range":[0,1050],"facets":[{"type":"media","indices":[281,304],"id":"2102651715615100929","display":"pic.x.com/0UsuKZ67qq","original":"https://t.co/0UsuKZ67qq","replacement":"https://x.com/AGTPinsights/status/2102651799987732852/photo/1"}]},"author":{"screen_name":"AGTPinsights","url":"https://x.com/AGTPinsights","id":"2013613489798160388","followers":3483,"following":85,"likes":684,"media_count":2406,"statuses":23347,"name":"AGTP","description":"Live at 10am ET every Monday and Thursday, hosted by @MichaelWaitze and @RonfortMartin.","raw_description":{"text":"Live at 10am ET every Monday and Thursday, hosted by @MichaelWaitze and @RonfortMartin.","facets":[]},"location":"Los Angeles, CA","banner_url":"https://pbs.twimg.com/profile_banners/2013613489798160388/1787487648","avatar_url":"https://pbs.twimg.com/profile_images/2091502140917415936/CNbeDaNw_200x200.jpg","joined":"Tue Jan 20 14:04:48 +0000 2026","protected":false,"website":{"url":"https://youtube.co