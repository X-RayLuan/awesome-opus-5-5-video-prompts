"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2104036177623879681/vid/avc1/640x360/bHx-K1CtzxdjL6QW.mp4?tag=29","bitrate":832000,"container":"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2104036177623879681/vid/avc1/1280x720/m_qNU6qmWVIe3CSw.mp4?tag=29","bitrate":2176000,"container":"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2104036177623879681/vid/avc1/1920x1080/XoBBeMZdjtr5xtYJ.mp4?tag=29","bitrate":10368000,"container":"mp4","codec":"h264"}],"publisher":null}]},"source":"Twitter Web App","provider":"twitter","reposted_by":null}],"replies":[{"type":"status","url":"https://x.com/cosmintrica/status/2104037512003887177","id":"2104037512003887177","text":"One request → 2.5 hours → $54\n\nIt wrote the story and every line on screen, then built everything from code: ~4,000 lines of JavaScript, a film look with bloom, grain and light leaks, and 4,368 frames at 1080p.\n\nThe music is original too. A second Claude agent composed the score and synthesized every sound - the cassette, the dial-up modem, the BUZZ!, the crickets - while the first one drew the frames.\n\n~2.5 hours from prompt to final file. ~$54. Rendered on CPU in the cloud, no GPU. No stock footage, no samples, no existing songs.\n\nMy favourite moment: the same grey, rainy courtyard gets repainted golden.\n\n\"Memory isn't an archive. It's a painter.\" 🥲","raw_text":{"text":"One request → 2.5 hours → $54\n\nIt wrote the story and every line on screen, then built everything from code: ~4,000 lines of JavaScript, a film look with bloom, grain and light leaks, and 4,368 frames at 1080p.\n\nThe music is original too. A second Claude agent composed the score and synthesized every sound - the cassette, the dial-up modem, the BUZZ!, the crickets - while the first one drew the frames.\n\n~2.5 hours from prompt to final file. ~$54. Rendered on CPU in the cloud, no GPU. No stock footage, no samples, no existing songs.\n\nMy favourite moment: the same grey, rainy courtyard gets repainted golden.\n\n\"Memory isn't an archive. It's a painter.\" 🥲","display_text_range":[0,660],"facets":[]},"author":{"screen_name":"cosmintrica","url":"https://x.com/cosmintrica","id":"3888254055","followers":108,"following":115,"likes":21581,"media_count":511,"statuses":2769,"name":"Cosmin Trica","description":"Just a Romanian guy who wants to make the world a better place.","raw_description":{"text":"Just a Romanian guy who wants to make the world a better place.","facets":[]},"location":"Romania","banner_url":"https://pbs.twimg.com/profile_banners/3888254055/1623089404","avatar_url":"https://pbs.twimg.com/profile_images/2080341978835783680/HLm9lzEU_200x200.jpg","joined":"Wed Oct 07 08:17:57 +0000 2015","protected":false,"website":{"url":"http://cosmintrica.ro","display_url":"cosmintrica.ro"},"verification":{"verified":true,"verified_at":null,"type":"individual"},"type":"profile"},"replies":0,"reposts":0,"likes":1,"bookmarks":0,"quotes":0,"embed_card":"tweet","created_at":"Sun Sep 27 02:36:48 +0000 2026","created_timestamp":1790476608,"views":38,"is_note_tweet":true,"community_note":null,"lang":"en","replying_to":{"screen_name":"cosmintrica","status":"2104036566653923630","url":"https://x.com/cosmintrica/status/2104036566653923630","profile_url":"https://x.com/cosmintrica"},"media":{},"source":"Twitter Web App","provider":"twitter","reposted_by":null},{"type":"status","url":"https://x.com/IndependentEco/status/2104036714578899344","id":"2104036714578899344","text":"@cosmintrica @AnthropicAI @claudeai @ClaudeDevs This is clean","raw_text":{"text":"@cosmintrica @AnthropicAI @claudeai @ClaudeDevs This is clean","display_text_range":[48,61],"facets":[{"type":"mention","indices":[0,12],"original":"cosmintrica","id":"3888254055"},{"type":"mention","indices":[13,25],"original":"AnthropicAI","id":"1353836358901501952"},{"type":"mention","indices":[26,35],"original":"claudeai","id":"1943306828697550848"},{"type":"mention","indices":[36,47],"