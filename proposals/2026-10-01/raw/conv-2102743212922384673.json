n.)","display_text_range":[0,717],"facets":[]},"author":{"screen_name":"songkeys","url":"https://x.com/songkeys","id":"2663331055","followers":2340,"following":1513,"likes":1478,"media_count":362,"statuses":1330,"name":"songkeys 🐿️🦋@song.work","description":"i love (formerly hate) 𝕏 (formerly twitter), an ad platform (formerly social platform) to spam (formerly tweet).\n\n🌍 普通话/中文/华语/国语/汉语/broken engslih","raw_description":{"text":"i love (formerly hate) 𝕏 (formerly twitter), an ad platform (formerly social platform) to spam (formerly tweet).\n\n🌍 普通话/中文/华语/国语/汉语/broken engslih","facets":[]},"location":"songkeys.eth","banner_url":"https://pbs.twimg.com/profile_banners/2663331055/1731084320","avatar_url":"https://pbs.twimg.com/profile_images/1594939077391831040/DbPuVpLK_200x200.jpg","joined":"Sun Jul 20 15:15:34 +0000 2014","protected":false,"website":{"url":"https://bento.me/song","display_url":"bento.me/song"},"verification":{"verified":true,"verified_at":null,"type":"individual"},"type":"profile"},"replies":1,"reposts":0,"likes":4,"bookmarks":4,"quotes":0,"embed_card":"tweet","created_at":"Thu Sep 24 05:36:35 +0000 2026","created_timestamp":1790228195,"views":395,"is_note_tweet":true,"community_note":null,"lang":"en","replying_to":{"screen_name":"Schneizellll","status":"2102991724314505392","url":"https://x.com/Schneizellll/status/2102991724314505392","profile_url":"https://x.com/Schneizellll"},"media":{},"provider":"twitter","reposted_by":null},{"type":"status","url":"https://x.com/Schneizellll/status/2102997740053836070","id":"2102997740053836070","text":"@songkeys Woah thanks, and did you use like video generation or it is pure Javascript and etc? :D","raw_text":{"text":"@songkeys Woah thanks, and did you use like video generation or it is pure Javascript and etc? :D","display_text_range":[10,97],"facets":[{"type":"mention","indices":[0,9],"original":"songkeys","id":"2663331055"}]},"author":{"screen_name":"Schneizellll","url":"https://x.com/Schneizellll","id":"