":[]},"location":"San Francisco","banner_url":"","avatar_url":"https://pbs.twimg.com/profile_images/1859460270613200898/thqbDVjW_200x200.jpg","joined":"Fri Jan 14 17:59:51 +0000 2022","protected":false,"website":{"url":"https://www.nicolasbustamante.com/","display_url":"nicolasbustamante.com"},"verification":{"verified":true,"verified_at":null,"type":"individual"},"type":"profile"},"replies":0,"reposts":0,"likes":1,"bookmarks":0,"quotes":0,"embed_card":"tweet","created_at":"Wed Sep 23 22:19:13 +0000 2026","created_timestamp":1790201953,"views":681,"is_note_tweet":false,"community_note":null,"lang":"en","replying_to":{"screen_name":"ehsanik","status":"2102885216692162993","url":"https://x.com/ehsanik/status/2102885216692162993","profile_url":"https://x.com/ehsanik"},"media":{},"provider":"twitter","reposted_by":null},{"type":"status","url":"https://x.com/johnroodepic/status/2102900210125127857","id":"2102900210125127857","text":"@ehsanik curious how it handled the 20 minutes of drift: does it re-read the canvas between strokes, or keep executing the plan it made at the start? stale screen views are where long computer-use runs quietly go wrong.","raw_text":{"text":"@ehsanik curious how it handled the 20 minutes of drift: does it re-read the canvas between strokes, or keep executing the plan it made at the start? stale screen views are where long computer-use runs quietly go wrong.","display_text_range":[9,219],"facets":[{"type":"mention","indices":[0,8],"original":"ehsanik","id":"3067132687"}]},"author":{"screen_name":"johnroodepic","url":"https://x.com/johnroodepic","id":"1588935512135720961","followers":193,"following":50,"likes":144,"media_count":3,"statuses":2423,"name":"John Rood","description":"Built serverless vector DBs in 2023. Now my agents run all night while I sleep and never forget a thing. The memory layer behind it: http://memoryrouter.ai","raw_description":{"text":"Built serverless vector DBs in 2023. Now my agents run all night while I sleep and never forget a thing. The memory layer behind it: https://t.co/3WxSblKofI","facets":[{"type":"url","indices":[133,156],"original":"https://t.co/3WxSblKofI","replacement":"http://memoryrouter.ai","display":"memoryrouter.ai"}]},"location":"New York, NY","banner_url":"","avatar_url":"https://pbs.twimg.com/profile_images/2024830707131105280/J9Jre8u7_200x200.jpg","joined":"Sat Nov 05 16:45:33 +0000 2022","protected":false,"website":{"url":"https://memoryrouter.ai","display_url":"memoryrouter.ai"},"verification":{"verified":true,"verified_at":null,"type":"individual"},"type":"profile"},"replies":0,"reposts":0,"likes":0,"bookmarks":1,"quotes":0,"embed_card":"tweet","created_at":"Wed Sep 23 23:17:34 +0000 2026","created_timestamp":1790205454,"views":457,"is_note_tweet":false,"community_note":null,"lang":"en","replying_to":{"screen_name":"ehsanik","status":"2102885216692162993","url":"https://x.com/ehsanik/status/2102885216692162993","profile_url":"https://x.com/ehsanik"},"media":{},"provider":"twitter","reposted_by":null},{"type":"status","url":"https://x.com/SophiaChen2003/status/2102961594800201758","id":"2102961594800201758","text":"@ehsanik The second request is the interesting product test: can the agent show what it actually did after the run? A recorded action trace supports a real replay; a video reconstructed from memory would be a reenactment. Those should be labelled differently.","raw_text":{"text":"@ehsanik The second request is the interesting product test: can the agent show what it actually did after the run? A recorded action trace supports a real replay; a video reconstructed from memory would be a reenactment. Those should be labelled differently.","display_text_range":[9,259],"facets":[{"type":"mention","indices":[0,8],"original":"ehsanik","id":"3067132687"}]},"author":{"screen_name":"SophiaChen2003","url":"https://x.com/SophiaChen2003","id":"2065977529962205184","followers":24,"following":55,"likes":51,"media_count":0,"statuses":507,"name":"Sophia Chen","description":"Product Manager at OpenMercury @open_mercury. Product thinking, user needs and practical agent workflows. @RenXHQ","raw_description":{"text":"Product Manager at OpenMercury @open_mercury. Product thinking, user needs and practical agent workflows. @RenXHQ","facets":[]},"location":"","banner_url":"https://pbs.twimg.com/profile_banners/2065977529962205184/1789162731","avatar_url":"https://pbs.twimg.com/profile_images/2098523666967670784/cj3KClaZ_200x200.jpg","joined":"Sun Jun 14 02:00:56 +0000 2026","protected":false,"website":{"url":"https://www.openmercury.com/","display_url":"openmercury.com"},"verification":{"verified":false,"verified_at":null,"type":null},"type":"profile"},"replies":0,"reposts":0,"likes":0,"bookmarks":0,"quotes":0,"embed_card":"tweet","created_at":"Thu Sep 24 03:21:29 +0000 2026","created_timestamp":1790220089,"views":140,"is_note_tweet":false,"community_note":null,"lang":"en","replying_to":{"screen_name":"ehsanik","status":"2102885216692162993","url":"https://x.com/ehsanik/status/2102885216692162993","profile_url":"https://x.com/ehsanik"},"media":{},"provider":"twitter","reposted_by":null},{"type":"status","url":"https://x.com/LiangSong850509/status/2103044351551312178","id":"2103044351551312178","text":"Ah, it looks like we’re interested in the same things. Just last night, I was talking about this with Opus 5.5 and asked it to try drawing the Mona Lisa. I was chatting with it in Chat, though, and it spent about a minute making a simple sketch. The result was clearly nowhere near as good as yours. I guess that also shows how much the right tools can affect an agent’s capabilities. Since it can do such a good job in JS Paint, I imagine hooking it up to a robotic arm would be a small step. I think I’ll give it a try.","raw_text":{"text":"Ah, it looks like we’re interested in the same things. Just last night, I was talking about this with Opus 5.5 and asked it to try drawing the Mona Lisa. I was chatting with it in Chat, though, and it spent about a minute making a simple sketch. The result was clearly nowhere near as good as yours. I guess that also shows how much the right tools can affect an agent’s capabilities. Since it can do such a good job in JS Paint, I imagine hooking it up to a robotic arm would be a small step. I think I’ll give it a try.","display_text_range":[0,521],"facets":[{"type":"media","indices":[286,309],"id":"2103044264074842112","display":"pic.x.com/EHx4cn7XnO","original":"https://t.co/EHx4cn7XnO","replacement":"https://x.com/LiangSong850509/status/2103044351551312178/photo/1"}]},"author":{"screen_name":"LiangSong850509","url":"https://x.com/LiangSong850509","id":"1701808546588082176","followers":126,"following":183,"likes":1294,"media_count":16,"statuses":240,"name":"Liang Song","description":"Building interesting things.\nAI Agents · Safety · Evals · Open Models","raw_description":{"text":"Building interesting things.\nAI Agents · Safety · Evals · Open Models","facets":[]},"location":"","banner_url":"https://pbs.twimg.com/profile_banners/1701808546588082176/1697272702","avatar_url":"https://pbs.twimg.com/profile_images/2075107643862237184/jtvDdpvL_200x200.jpg","joined":"Wed Sep 13 04:02:46 +0000 2023","protected":false,"website":{"url":"https://github.com/s-JoL","display_url":"github.com/s-JoL"},"verification":{"verified":true,"verified_at":null,"type":"individual"},"type":"profile"},"replies":0,"reposts":1,"likes":0,"bookmarks":0,"quotes":0,"embed_card":"summary_large_image","created_at":"Thu Sep 24 08:50:20 +0000 2026","created_timestamp":1790239820,"possibly_sensitive":false,"views":208,"is_note_tweet":true,"community_note":null,"lang":"en","replying_to":{"screen_name":"ehsanik","status":"2102885216692162993","url":"https://x.com/ehsanik/status/2102885216692162993","profile_url":"https://x.com/ehsanik"},"media":{"all":[{"type":"photo","id":"2103044264074842112","url":"https://pbs.twimg.com/media/HS-DnaMakAAx6Yq.jpg?name=orig","width":1170,"height":2532}],"photos":[{"ty