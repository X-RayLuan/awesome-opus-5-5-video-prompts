g0uH3Zc7_Ih_ey.mp4?tag=29","bitrate":832000,"container":"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2102543614786043904/vid/avc1/1280x720/W2foRIl34IFMwJNJ.mp4?tag=29","bitrate":2176000,"container":"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2102543614786043904/vid/avc1/1920x1080/_IwxMaudz3bQHJuD.mp4?tag=29","bitrate":10368000,"container":"mp4","codec":"h264"}],"publisher":null}]},"provider":"twitter","reposted_by":null}],"replies":[{"type":"status","url":"https://x.com/leogao25/status/2102544080328671444","id":"2102544080328671444","text":"Setup:\n- Opus 5.5 in Claude Code, GPT-6 Astra in Codex CLI\n- high effort, fresh empty folders, no config files\n- both could run a browser to check their work\n- identical prompt, one shot, no follow-ups\n- cost = API list price for every token used\nFull prompt below","raw_text":{"text":"Setup:\n- Opus 5.5 in Claude Code, GPT-6 Astra in Codex CLI\n- high effort, fresh empty folders, no config files\n- both could run a browser to check their work\n- identical prompt, one shot, no follow-ups\n- cost = API list price for every token used\nFull prompt below","display_text_range":[0,264],"facets":[]},"author":{"screen_name":"leogao25","url":"https://x.com/leogao25","id":"1886939808163094532","followers":108,"following":161,"likes":367,"media_count":44,"statuses":250,"name":"leo","description":"i like jazz | 🇨🇦 | @embedder_dev | @UMich","raw_description":{"text":"i like jazz | 🇨🇦 | @embedder_dev | @UMich","facets":[]},"location":"San Francisco, CA","banner_url":"https://pbs.twimg.com/profile_banners/1886939808163094532/1762114027","avatar_url":"https://pbs.twimg.com/profile_images/2095942047337443328/0T5aJaKO_200x200.jpg","joined":"Wed Feb 05 00:48:17 +0000 2025","protected":false,"website":null,"verification":{"verified":true,"verified_at":null,"type":"individual"},"type":"profile"},"replies":2,"reposts":0,"likes":1,"bookmarks":0,"quotes":0,"embed_card":"tweet","created_at":"Tue Sep 22 23:42:26 +0000 2026","created_timestamp":1790120546,"views":253,"is_note_tweet":false,"community_note":null,"lang":"en","replying_to":{"screen_name":"leogao25","status":"2102544078927741369","url":"https://x.com/leogao25/status/2102544078927741369","profile_url":"https://x.com/leogao25"},"media":{},"source":"Twitter Web App","provider":"twitter","reposted_by":null},{"type":"status","url":"https://x.com/leogao25/status/2102544081863717153","id":"2102544081863717153","text":"The prompt:\n\nBuild a 3D Rube Goldberg machine that runs itself, as a single self-contained index.html in the current directory.\n\nThe chain, in order:\n1. A marble is released at the top and rolls down a series of zig-zag ramps.\n2. It knocks over a line of at least 12 dominoes.\n3. The last domino tips a seesaw, which launches a small ball into a hanging bucket.\n4. The bucket's weight pulls it down; its rope runs over a pulley and yanks a bell, which visibly swings.\n5. The same motion raises a flag up a pole. The flag reaching the top is the finish.\n\nRules:\n- Write the physics yourself: no physics library. Every motion after the marble is released must come from your simulation (rigid bodies, collisions, constraints, rope/pulley). No keyframed animation or tweened motion of any machine part.\n- You may load three.js from a CDN for rendering. Nothing else external: no images, models, or fonts.\n- It must run with no user input: start automatically on page load, use a cinematic camera that follows the action, and complete the whole chain in about 15–20 seconds. After the flag is up, hold for 2 seconds, then reset and replay.\n- Deterministic: fixed timestep and no unseeded randomness, so every run looks the same.\n- Fill the browser window. It will be screen-recorded at 1280×720.\n- No on-screen text or UI of any kind.\n- Make it look good: lighting, shadows, materials, and a setting that makes it feel like a real contraption.","raw_text":{"text":"The prompt:\n\nBuild a 3D Rube Goldberg machine that runs itself, as a single self-contained index.html in the current directory.\n\nThe chain, in order:\n1. A marble is released at the top and rolls down a series of zig-zag ramps.\n2. It knocks over a line of at least 12 dominoes.\n3. The last domino tips a seesaw, which launches a small ball into a hanging bucket.\n4. The bucket's weight pulls it down; its rope runs over a pulley and yanks a bell, which visibly swings.\n5. The same motion raises a flag up a pole. The flag reaching the top is the finish.\n\nRules:\n- Write the physics yourself: no physics library. Every motion after the marble is released must come from your simulation (rigid bodies, collisions, constraints, rope/pulley). No keyframed animation or tweened motion of any machine part.\n- You may load three.js from a CDN for rendering. Nothing else external: no images, models, or fonts.\n- It must run with no user input: start automatically on page load, use a cinematic camera that follows the action, and complete the whole chain in about 15–20 seconds. After the flag is up, hold for 2 seconds, then reset and replay.\n- Deterministic: fixed timestep and no unseeded randomness, so every run looks the same.\n- Fill the browser window. It will be screen-recorded at 1280×720.\n- No on-screen text or UI of any kind.\n- Make it look good: lighting, shadows, materials, and a setting that makes it feel like a real contraption.","display_text_range":[0,1439],"facets":[]},"author":{"screen_name":"leogao25","url":"https://x.com/leogao25","id":"1886939808163094532","followers":108,"following":161,"likes":367,"media_count":44,"statuses":250,"name":"leo","description":"i like jazz | 🇨🇦 | @embedder_dev | @UMich","raw_description":{"text":"i like jazz | 🇨🇦 | @embedder_dev | @UMich","facets":[]},"location":"San Francisco, CA","banner_url":"https://pbs.twimg.com/profile_banners/1886939808163094532/1762114027","avatar_url":"https://pbs.twimg.com/profile_images/2095942047337443328/0T5aJaKO_200x200.jpg","joined":